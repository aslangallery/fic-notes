views:
  - type: cards
    name: FIC
    filters:
      and:
        - from == "fic"
    order:
      - file.basename
      - curso
    sort:
      - property: curso
        direction: DESC
    image: note.cover
    imageAspectRatio: 1
    imageFit: ""
  - type: cards
    name: MaD
    filters:
      and:
        - asignatura == "MaD"
    imageFit: ""
  - type: cards
    name: PDS
    filters:
      and:
        - asignatura == "PDS"
  - type: cards
    name: SIE
    filters:
      and:
        - asignatura == "SIE"
  - type: cards
    name: SN
    filters:
      and:
        - asignatura == "SN"
  - type: cards
    name: CP
    filters:
      and:
        - asignatura == "CP"
  - type: cards
    name: SI
    filters:
      and:
        - asignatura == "SI"
